      "first_payload": [
        {
          "id": 0,
          "text": "The French Empire Mansard Building was constructed by James Simpson, a well known builder who constructed several other large buildings, in 1883 to house the new lodge hall for the Independent Order of Odd Fellows. The large two story building was constructed of brick with an imposing two story entrance pavilion bordered by specially formed iron columns. This is Eureka's finest example of Second Empire architecture.",
          "source_start": 0,
          "source_end": 419,
          "section": "",
          "source": "https://noehill.com/humboldt/nat1978000673.asp",
          "locator": "paragraphs[1]+3",
          "document_title": "National Register #78000673: Odd Fellows Hall in Eureka, California"
        },
        {
          "id": 1,
          "text": "National Register #78000673 Odd Fellows Hall 123 F Street Eureka Built 1883",
          "source_start": 0,
          "source_end": 75,
          "section": "",
          "source": "https://noehill.com/humboldt/nat1978000673.asp",
          "locator": "block[10]",
          "document_title": "National Register #78000673: Odd Fellows Hall in Eureka, California"
        },
        {
          "id": 2,
          "text": "description: This French Empire Mansard building was constructed by James Simpson in 1883 to house the new lodge hall for the Independent Order of Odd Fellows.",
          "source_start": 0,
          "source_end": 159,
          "section": "",
          "source": "https://noehill.com/humboldt/nat1978000673.asp",
          "locator": "meta[0]",
          "document_title": "National Register #78000673: Odd Fellows Hall in Eureka, California"
        },
        {
          "id": 3,
          "text": "The French Empire Mansard Building was constructed by James Simpson, a well known builder who constructed several other large buildings, in 1883 to house the new lodge hall for the Independent Order of Odd Fellows.",
          "source_start": 0,
          "source_end": 214,
          "section": "",
          "source": "https://noehill.com/humboldt/nat1978000673.asp",
          "locator": "p[9]:0",
          "document_title": "National Register #78000673: Odd Fellows Hall in Eureka, California"
        },
        {
          "id": 4,
          "text": "This two-story wood-frame structure in the Greek Revival architectural style was constructed shortly after the fire of 1899 on the site of an earlier lodge building.",
          "source_start": 0,
          "source_end": 165,
          "section": "",
          "source": "https://noehill.com/mariposa/poi_coulterville_odd_fellows_hall.asp",
          "locator": "p[9]:0",
          "document_title": "Historic Point of Interest in Coulterville, California: Odd Fellows Hall"
        },
        {
          "id": 5,
          "text": "The Coulterville Odd Fellows Hall contributes to the National Register Coulterville Historic District .",
          "source_start": 0,
          "source_end": 103,
          "section": "",
          "source": "https://noehill.com/mariposa/poi_coulterville_odd_fellows_hall.asp",
          "locator": "p[13]:0",
          "document_title": "Historic Point of Interest in Coulterville, California: Odd Fellows Hall"
        },
        {
          "id": 6,
          "text": "Coulterville Odd Fellows Hall Main Street Coulterville Built 1900",
          "source_start": 0,
          "source_end": 65,
          "section": "",
          "source": "https://noehill.com/mariposa/poi_coulterville_odd_fellows_hall.asp",
          "locator": "block[10]",
          "document_title": "Historic Point of Interest in Coulterville, California: Odd Fellows Hall"
        },
        {
          "id": 7,
          "text": "The interior of this structure is almost completely intact. A large meeting room surrounded by several smaller meeting rooms is located on the second story. The lower level is a large, open dance hall and meeting room, with a stage and proscenium at the rear. The Coulterville Odd Fellows Hall contributes to the National Register Coulterville Historic District .",
          "source_start": 0,
          "source_end": 363,
          "section": "",
          "source": "https://noehill.com/mariposa/poi_coulterville_odd_fellows_hall.asp",
